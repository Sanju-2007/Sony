# ==============================================================================
# SOCIAL LISTENING & REALTIME PRESENCE PLATFORM - CONFIGURATION
# ==============================================================================

# NODE ENVIRONMENT
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# SECURITY & AUTHENTICATION
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# DATABASE (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/social_music_db?schema=public

# REDIS (Presence, Room State, Distributed Locks, Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LIVEKIT (WebRTC Realtime Voice Rooms)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_key_at_least_32_characters_long

# S3 COMPATIBLE OBJECT STORAGE (Voice Messages, Avatars)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=social-music-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# MUSIC PROVIDER TOKENS (OPTIONAL FOR FIRST-PARTY/ROYALTY-FREE PROTOTYPING)
APPLE_DEVELOPER_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# EMAIL DISPATCH & REAL-TIME OTP DELIVERY (Resend or SMTP / Gmail)
# Option A: Resend (Recommended for production: https://resend.com)
RESEND_API_KEY=
# Option B: SMTP Relay (e.g. Gmail: smtp.gmail.com with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender Information
EMAIL_FROM="Sony Social Listening <auth@sonysocial.com>"

