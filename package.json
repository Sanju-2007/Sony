{
  "name": "social-music-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade social music listening and realtime presence platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@sony/types && npm run build --workspace=@sony/music-core && npm run build --workspace=@sony/audio-ducking",
    "build": "npm run build:packages && npm run build --workspace=@sony/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev": "npm run web --workspace=@sony/mobile",
    "start": "npm run web --workspace=@sony/mobile",
    "web": "npm run web --workspace=@sony/mobile",
    "api:dev": "npm run start:dev --workspace=@sony/api",
    "mobile:start": "npm run start --workspace=@sony/mobile",
    "mobile:build": "npm run build:web --workspace=@sony/mobile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
